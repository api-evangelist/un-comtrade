        {
          "id": "ca553784-5dab-484c-bfe4-de6dba293dc5",
          "name": "Bulk Download Trade Data",
          "request": {
            "name": "Bulk Download Trade Data",
            "description": {
              "content": "Retrieve links to bulk files containing large trade datasets. Supports downloads up to 2.5 million records via asynchronous processing. Returns file URLs rather than inline data. Requires a premium subscription.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bulk",
                "v1",
                "get",
                ":typeCode",
                ":freqCode",
                ":clCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "reporterCode",
                  "value": "<string>",
                  "description": "UN M49 numeric country code for the reporting country. Comma-separated for multiple. E.g. 156 for China, 840 for USA."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Year (YYYY for annual) or year-month (YYYYMM for monthly). Multiple values comma-separated, max 12 values."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "typeCode",
                  "description": "(Required) Trade type: C for Goods (Commodities), S for Services"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "freqCode",
                  "description": "(Required) Reporting frequency: A for Annual, M for Monthly"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "clCode",
                  "description": "(Required) Commodity classification code: HS (latest), H5–H0 (HS revisions), S4–S0 (SITC revisions), B4/B3 (BEC), EB02 (Extended BEC)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Ocp-Apim-Subscription-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
