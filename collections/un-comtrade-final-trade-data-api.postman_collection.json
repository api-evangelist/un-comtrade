{
  "item": [
    {
      "id": "02a6ed9a-2b84-4319-ab4b-c3e1834dcbff",
      "name": "Final Trade Data",
      "description": {
        "content": "Authenticated endpoints for full final trade data extraction (up to 250,000 records per call).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "86ea714f-cf6f-478c-876c-381e2476cf84",
          "name": "Get Final Trade Data",
          "request": {
            "name": "Get Final Trade Data",
            "description": {
              "content": "Extract up to 250,000 records of final trade data per call. Returns merchandise or services trade flows filtered by reporter, partner, commodity, period, and flow. Requires a valid API subscription key.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "v1",
                "get",
                ":typeCode",
                ":freqCode",
                ":clCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "reporterCode",
                  "value": "<string>",
                  "description": "UN M49 numeric country code for the reporting country. Comma-separated for multiple. E.g. 156 for China, 840 for USA."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Year (YYYY for annual) or year-month (YYYYMM for monthly). Multiple values comma-separated, max 12 values."
                },
                {
                  "disabled": false,
                  "key": "cmdCode",
                  "value": "<string>",
                  "description": "Commodity code(s), comma-separated. Use TOTAL for aggregate."
                },
                {
                  "disabled": false,
                  "key": "partnerCode",
                  "value": "<string>",
                  "description": "UN M49 numeric country code for the partner country. Use 0 for World."
                },
                {
                  "disabled": false,
                  "key": "partner2Code",
                  "value": "<string>",
                  "description": "Secondary partner country code (used for triangular trade)."
                },
                {
                  "disabled": false,
                  "key": "flowCode",
                  "value": "<string>",
                  "description": "Trade flow: M=Import, X=Export, MIP=Import in-transit, XIP=Export in-transit, MOP=Import of goods for outward processing, XOP=Export for outward processing, RM=Re-import, RX=Re-export"
                },
                {
                  "disabled": false,
                  "key": "maxRecords",
                  "value": "<integer>",
                  "description": "Maximum number of records to return (max 250,000)"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format: json (default), csv, or txt"
                },
                {
                  "disabled": false,
                  "key": "breakdownMode",
                  "value": "<string>",
                  "description": "Data breakdown mode: classic (legacy columns) or plus (extended columns)"
                },
                {
                  "disabled": false,
                  "key": "includeDesc",
                  "value": "true",
                  "description": "Include commodity and country description labels in the response."
                },
                {
                  "disabled": false,
                  "key": "motCode",
                  "value": "<string>",
                  "description": "Mode of transport code."
                },
                {
                  "disabled": false,
                  "key": "customsCode",
                  "value": "<string>",
                  "description": "Customs procedure code."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "typeCode",
                  "description": "(Required) Trade type: C for Goods (Commodities), S for Services"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "freqCode",
                  "description": "(Required) Reporting frequency: A for Annual, M for Monthly"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "clCode",
                  "description": "(Required) Commodity classification code: HS (latest), H5–H0 (HS revisions), S4–S0 (SITC revisions), B4/B3 (BEC), EB02 (Extended BEC)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Ocp-Apim-Subscription-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
