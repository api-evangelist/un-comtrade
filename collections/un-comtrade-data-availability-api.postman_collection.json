      "item": [
        {
          "id": "393b3974-f2ec-4535-9ba1-828a223116f1",
          "name": "Get Data Availability",
          "request": {
            "name": "Get Data Availability",
            "description": {
              "content": "Retrieve information about which reporting countries have submitted trade data for given periods and classifications. Useful for determining what data is available before making data extraction calls.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "v1",
                "getDa",
                ":typeCode",
                ":freqCode",
                ":clCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "reporterCode",
                  "value": "<string>",
                  "description": "UN M49 numeric country code for the reporting country. Comma-separated for multiple. E.g. 156 for China, 840 for USA."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Year (YYYY for annual) or year-month (YYYYMM for monthly). Multiple values comma-separated, max 12 values."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "typeCode",
                  "description": "(Required) Trade type: C for Goods (Commodities), S for Services"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "freqCode",
                  "description": "(Required) Reporting frequency: A for Annual, M for Monthly"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "clCode",
                  "description": "(Required) Commodity classification code: HS (latest), H5–H0 (HS revisions), S4–S0 (SITC revisions), B4/B3 (BEC), EB02 (Extended BEC)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Ocp-Apim-Subscription-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
